# ---------------------------------------------------------------------------
# Bill Locker frontend configuration (all values are public — never put secrets
# in VITE_* variables, they are compiled into the browser bundle).
# Copy to `.env.local` to override the defaults in `.env.development`.
# ---------------------------------------------------------------------------

# Base URL of the REST API. Keep `/api` to use the Vite dev proxy (dev) or the
# nginx reverse proxy (Docker). Use an absolute URL only if the API is on
# another origin (the backend must then allow this origin via CORS).
VITE_API_BASE_URL=/api

# `true` = run against the in-browser mock API (Mock Service Worker) with demo
# data — no backend needed. `false` = call the real Spring Boot backend.
VITE_API_MOCKING=true

# Show the "Use demo account" shortcut on the login page.
VITE_SHOW_DEMO_LOGIN=true

# Client-side upload limit in MB (the backend enforces its own limit too).
VITE_MAX_UPLOAD_MB=10

# Dev server only: where `/api` is proxied when VITE_API_MOCKING=false.
VITE_PROXY_TARGET=http://localhost:8080
