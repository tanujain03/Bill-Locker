# Copy this file to backend/.env (git-ignored) and fill in your own values.
# Never commit backend/.env: it holds passwords and keys.

# ---- Local PostgreSQL ----
DATABASE_URL=jdbc:postgresql://localhost:5432/BillLocker
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# ---- Login tokens: 32 or more random characters ----
JWT_SECRET=

# ---- Gmail import (step 7, see docs/step-7-codes-and-gmail.md) ----
# From the Google Cloud console: APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes in Base64; encrypts the stored Google tokens. Make one in Git Bash with:
#   openssl rand -base64 32
GMAIL_TOKEN_KEY=
# Where the app runs: the browser comes back here after connecting Gmail.
FRONTEND_URL=http://localhost:5173
