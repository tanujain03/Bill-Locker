# Copy to backend/.env (git-ignored) and fill in your own values.
DATABASE_URL=jdbc:postgresql://localhost:5432/BillLocker
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Signs login tokens (32+ characters). Changing it logs everyone out.
JWT_SECRET=

# Where password reset links point (the frontend). Default: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email for password reset links (SMTP). Leave MAIL_USERNAME empty to only log the links.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste its 16 letters (no spaces) below.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Reading bills with AI (Google Gemini, free tier). Get a key (no card needed) at
# https://aistudio.google.com/apikey. Note: on the free tier Google may use what you
# send to improve its products, so prefer test bills. Leave empty to type details by hand.
GEMINI_API_KEY=
# Optional: use another Gemini model (remove the # to change it). Comma-separated = backups,
# tried in order when a model is busy or out of quota, e.g. gemini-3.5-flash,gemini-2.5-flash
# GEMINI_MODEL=gemini-3.5-flash

# Gmail import (optional; Gmail import stays off until the first three are set).
# Create an OAuth "Web application" client in Google Cloud Console, enable the Gmail API,
# add every Gmail address you connect as a Test user, and add the redirect URI below.
# Step by step: docs/task-3-gmail.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Gmail tokens: 32 random bytes in base64. Make one with: openssl rand -base64 32
# Keep it once set: if it changes, everyone has to connect Gmail again.
GMAIL_TOKEN_KEY=
# Optional: only if your redirect address is not this default (it must match Google exactly).
# GMAIL_REDIRECT_URI=http://localhost:8080/api/integrations/gmail/callback
